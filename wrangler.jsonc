{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sourcepay",
  "main": "worker.ts",
  // `wrangler deploy` builds the Next.js app and applies D1 migrations first.
  "build": { "command": "npx opennextjs-cloudflare build && npx wrangler d1 migrations apply sourcepay --remote" },
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "sourcepay", "database_id": "1d053d39-02c2-4737-b50b-e37955e1ffeb", "migrations_dir": "migrations" }
  ],
  // Daily settlement: payout retries, refund status, 14 day unclaimed refunds.
  "triggers": { "crons": ["0 7 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "ENABLE_UNCLAIMED_PAYMENTS": "false"
  }
}
